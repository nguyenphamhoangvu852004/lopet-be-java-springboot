# Mẫu cấu hình nginx — KHÔNG phải file nginx đọc trực tiếp.
#
# docker/entrypoint.sh chạy `envsubst '${PORT} ${REST_PORT} ${SOCK_PORT}'` trên file này rồi
# ghi kết quả ra /app/runtime/nginx.conf. Danh sách biến truyền cho envsubst là BẮT BUỘC: gọi
# envsubst không tham số thì nó thay MỌI thứ trông giống $tên — $http_upgrade, $host,
# $remote_addr, $proxy_add_x_forwarded_for của chính nginx đều thành chuỗi rỗng, và cấu hình
# sinh ra tuy vẫn parse được nhưng mất sạch header proxy. Đúng ba biến trên được phép thay,
# và cả ba đều do entrypoint tự đặt — không lấy từ Render Environment.
#
# Vì sao cần lớp nginx này: Render chỉ mở đúng MỘT cổng công khai ($PORT do Render cấp lúc
# chạy), trong khi JVM này mở hai — Tomcat cho REST và netty-socketio cho realtime. Không có
# reverse proxy thì Render chỉ định tuyến tới một trong hai, và wss://.../socket.io/ luôn hỏng.

worker_processes auto;

# Cả pid lẫn thư mục tạm đều nằm trong /app/runtime: container chạy bằng user `lopet` (không
# phải root) nên không ghi được /run hay /var/lib/nginx như mặc định của gói Debian.
pid /app/runtime/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    # Đường dẫn tuyệt đối: chạy bằng `nginx -c /app/runtime/nginx.conf` thì include tương đối
    # được nginx giải theo thư mục chứa file config, không phải /etc/nginx như mặc định.
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;

    client_body_temp_path /app/runtime/client-body;
    proxy_temp_path       /app/runtime/proxy;
    fastcgi_temp_path     /app/runtime/fastcgi;
    uwsgi_temp_path       /app/runtime/uwsgi;
    scgi_temp_path        /app/runtime/scgi;

    sendfile      on;
    tcp_nopush    on;
    server_tokens off;

    # Mặc định của nginx là 1MB, tức là nó sẽ trả 413 trước khi request kịp tới Spring. Phải
    # nới ít nhất bằng MAX_REQUEST_SIZE trong application.yml (500MB), không thì mọi upload
    # ảnh/video lên Cloudinary chết ở tầng proxy.
    client_max_body_size 500m;

    # WebSocket handshake: header Connection phải là "upgrade" khi client xin nâng cấp, và là
    # "close" khi không (long-polling). Hard-code "upgrade" sẽ làm hỏng transport polling —
    # thứ mà socket.io-client luôn dùng cho lần kết nối đầu tiên trước khi nâng cấp.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream lopet_rest {
        server 127.0.0.1:${REST_PORT};
        keepalive 32;
    }

    upstream lopet_socket {
        server 127.0.0.1:${SOCK_PORT};
        keepalive 32;
    }

    server {
        listen      ${PORT};
        listen      [::]:${PORT};
        server_name _;

        # netty-socketio (SocketIoConfig). Đường dẫn /socket.io/ là mặc định của giao thức
        # EIO4, client không cấu hình gì thêm.
        location /socket.io/ {
            proxy_pass http://lopet_socket;
            proxy_http_version 1.1;

            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Socket rảnh rỗi hàng chục phút là chuyện thường (người dùng mở tab rồi để đó).
            # Mặc định 60s sẽ cắt kết nối giữa chừng, client phải reconnect liên tục.
            proxy_read_timeout  3600s;
            proxy_send_timeout  3600s;

            # Không đệm: gói realtime phải ra tới client ngay, đệm lại là thêm độ trễ.
            proxy_buffering off;
        }

        # Tomcat — toàn bộ REST API còn lại.
        location / {
            proxy_pass http://lopet_rest;
            proxy_http_version 1.1;

            proxy_set_header Host       $host;
            proxy_set_header X-Real-IP  $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";

            proxy_read_timeout 300s;
            proxy_send_timeout 300s;

            # Upload file lớn: đẩy thẳng lên Tomcat thay vì ghi trọn 500MB xuống đĩa container
            # rồi mới chuyển tiếp.
            proxy_request_buffering off;
        }
    }
}
