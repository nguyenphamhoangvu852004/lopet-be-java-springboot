# Copy sang `.env` rồi điền giá trị thật. `.env` bị .gitignore.

# App
APP_PORT=8080
LOG_LEVEL=info

# MySQL
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_NAME=socialmedia
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Redis
REDIS_HOSTNAME=localhost
REDIS_PORT=6379

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ADMIN_RECEIVER=

# Upload
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=500MB

# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=36000

# CORS
DOMAIN_CORS=*

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin khởi tạo
INIT_ADMIN_EMAIL=
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# Socket.IO
SOCKET_HOSTNAME=localhost
SOCKET_PORT=8081
