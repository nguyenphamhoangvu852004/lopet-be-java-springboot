# Copy sang `.env` rồi điền giá trị thật. `.env` bị .gitignore.

# App
APP_PORT=8080
LOG_LEVEL=info
SPRING_PROFILES_ACTIVE=

# MySQL
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_NAME=socialmedia
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Redis
REDIS_HOSTNAME=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Resend — https://resend.com)
# API key lấy ở https://resend.com/api-keys, bắt đầu bằng `re_`.
RESEND_API_KEY=
# Địa chỉ gửi. Domain phải được verify ở https://resend.com/domains.
# Khi chưa verify domain nào, dùng onboarding@resend.dev — nhưng nó CHỈ gửi được tới
# email chủ tài khoản Resend, mọi địa chỉ khác bị API từ chối.
MAIL_FROM=Lopet <onboarding@resend.dev>
MAIL_ADMIN_RECEIVER=

# Upload
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=500MB

# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=36000

# CORS
DOMAIN_CORS=*

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

INIT_ADMIN_EMAIL=
INIT_ADMIN_USERNAME=
INIT_ADMIN_PASSWORD=

# Demo data
SEED_DEMO=true
